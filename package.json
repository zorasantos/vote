{
  "name": "boilerplate-vue3-vite-typescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "biome check --write --no-errors-on-unmatched",
      "yarn test"
    ]
  },
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit && biome lint src",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "coverage": "vitest run --coverage",
    "build": "vite build",
    "test": "vitest --no-watch -- --bail",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepare": "husky install"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@pinia/testing": "^2.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
